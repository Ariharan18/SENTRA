APP_ENV=development
DATABASE_URL=mysql+pymysql://traffic_user:change-this-password@localhost:3306/traffic_db
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:8501
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=traffic_db
MYSQL_USER=traffic_user
MYSQL_PASSWORD=replace-with-local-app-password
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
CONGESTION_HIGH_THRESHOLD=51
CONGESTION_SEVERE_THRESHOLD=76
